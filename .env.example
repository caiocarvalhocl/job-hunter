# === AI ===
# Optional: enables Claude Haiku fallback when Groq is rate-limited
ANTHROPIC_API_KEY=
GROQ_API_KEY=your_groq_api_key_here

# === TELEGRAM ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# === JOB SEARCH ===
SEARCH_KEYWORDS=Java,Spring Boot,Backend Developer,QA,Quality Assurance,Test Automation,QA Automation,SDET,Analista de Testes,Selenium,Playwright,Cypress,REST Assured,Estágio,Estagiário,Trainee,Technical Support,Support Engineer,Help Desk,Suporte Técnico
SEARCH_LOCATION=Brasil
SEARCH_REMOTE_ONLY=true
MIN_FIT_SCORE=60
MIN_CV_SCORE=80

# Política geográfica por track. Formato "track:regra,track:regra".
# Regras: anywhere | abroad_only | domestic_only. Track não listado = anywhere.
TRACK_RULES=dev:anywhere,qa:abroad_only,support:abroad_only

# Vagas de ação afirmativa reservadas para PCD são excluídas por padrão.
# Coloque false se você é PCD e quer receber essas vagas também.
EXCLUDE_PCD_RESERVED=true

# === DATABASE ===
DATABASE_URL=sqlite:///./job_hunter.db

# === SCHEDULER ===
SCRAPE_INTERVAL_HOURS=6

# === REGIONAL (presencial/híbrido) ===
# Onsite/hybrid jobs are accepted only in these cities (sudoeste do PR).
ALLOW_ONSITE_IN_REGION=true
# LOCAL_REGION_CITIES=Dois Vizinhos,Francisco Beltrão,Pato Branco,...  (override default list)
